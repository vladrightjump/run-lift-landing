{
  "name": "run-lift-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:deploy-config": "tsx scripts/check-deploy-config.ts",
    "build": "tsx scripts/check-deploy-config.ts && tsc -b && vite build && tsx scripts/write-version.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "E2E_PREVIEW=1 playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run test && npm run build && npm run test:e2e:preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.10"
  }
}

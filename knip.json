{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/admin-preview.tsx",
    "scripts/*.{ts,mjs}",
    "tests/e2e/**/*.spec.ts",
    "{src,tests}/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}"
  ],
  "vitest": {
    "entry": [
      "{src,tests}/**/*.test.{ts,tsx}"
    ]
  }
}
